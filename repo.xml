<?xml version="1.0" encoding="utf-8"?>
<!--
    LMS Custom Repository descriptor for AirPlay2Bridge.
    Живёт в КОРНЕ проекта и пушится в корень репозитория как есть —
    LMS читает его по raw-URL ветки main.

    USERS: Add the raw GitHub URL of this file to:
      LMS Settings -> Plugins -> Additional Repositories
      URL: https://raw.githubusercontent.com/knovash/airplay/main/repo.xml

    MAINTAINERS: When publishing a new version:
      1) bump <version> in AirPlay2Bridge/install.xml and here
      2) ./make_dist.sh  -> dist/AirPlay2Bridge-vX.Y.zip (prints sha1)
      3) create GitHub release vX.Y, upload the zip as asset
      4) update sha= and url= below
-->
<extensions>
    <details>
        <title lang="EN">AirPlay2Bridge Repository</title>
        <title lang="RU">Репозиторий AirPlay2Bridge</title>
    </details>
    <plugins>
        <plugin
            name="AirPlay2Bridge"
            version="1.3"
            target="unix|mac"
            minTarget="8.0"
            maxTarget="*"
            sha="32ef9ec9a0085a60ef3e0d8ef0e4b7cac84cbfd9"
            url="https://github.com/knovash/airplay/releases/download/v1.3/AirPlay2Bridge-v1.3.zip"
            icon="https://raw.githubusercontent.com/knovash/airplay/main/AirPlay2Bridge/HTML/EN/plugins/AirPlay2Bridge/html/images/icon.png"
            creator="Konstantin"
            email="novash.ki@gmail.com"
        >
            <title lang="EN">AirPlay Bridge</title>
            <title lang="RU">AirPlay Bridge</title>
            <desc lang="EN">Use HomePods OS 27 in LMS</desc>
            <desc lang="RU">Использование HomePod с OS 27 в LMS</desc>
        </plugin>
    </plugins>
</extensions>
